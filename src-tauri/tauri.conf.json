{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GMeer",
  "version": "1.0.0",
  "identifier": "nl.mikkie.gmeer",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GMeer — Google Agenda Tray",
        "width": 440,
        "height": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "Mikkie",
    "copyright": "© 2026 Mikkie",
    "category": "Productivity",
    "shortDescription": "Google Agenda herinneringen in het systeemvak",
    "longDescription": "GMeer toont je Google Agenda-afspraken in het Windows-systeemvak, met herinneringen, snel toevoegen en 'Naar morgen' verplaatsen.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Dutch"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "GMeer",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
